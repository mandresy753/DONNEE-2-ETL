# Copier ce fichier en .env et renseigner les valeurs réelles.
# En local uniquement : sur GitHub Actions, ces valeurs viennent des secrets du repo
# (Settings > Secrets and variables > Actions), pas de ce fichier.

API_KEY=votre_cle_openweathermap
NEON_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Optionnel - paramètres du backfill (valeurs par défaut ci-dessous)
# BACKFILL_MONTHS=3
# BACKFILL_CHUNK_DAYS=15
# BACKFILL_REQUEST_DELAY=1
